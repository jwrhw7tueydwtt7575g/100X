# ---------------------------------------------------------------------------
# WariVerse backend — environment configuration
# Copy to `.env` and fill in real values. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
# Async driver is added automatically if you pass a plain postgresql:// URL.
DATABASE_URL=postgresql+asyncpg://wariverse:wariverse@localhost:5432/wariverse
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=sk-replace-me
JWT_SECRET=replace-with-a-long-random-string

# --- App -------------------------------------------------------------------
ENVIRONMENT=local          # local | dev | staging | production
DEBUG=true
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_JSON=true

# --- CORS ------------------------------------------------------------------
# JSON array. The Expo dev client runs on :8081.
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
# Wildcard subdomains cannot be expressed in CORS_ORIGINS, so *.wariverse.app
# is matched with this regex instead.
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*wariverse\.app$

# --- Database pool ---------------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis -----------------------------------------------------------------
REDIS_TTL_SECONDS=300

# --- LLM -------------------------------------------------------------------
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
# When false the orchestrator always uses the offline rule-based responder.
LLM_ENABLED=true

# --- Auth / OTP ------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200   # 30 days — pilgrims stay logged in for the walk
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
# Returns the OTP in the API response so you can test without an SMS gateway.
# Forced OFF when ENVIRONMENT=production.
OTP_DEBUG_ECHO=true

# --- Domain defaults -------------------------------------------------------
DEFAULT_LANGUAGE=mr
FACILITY_DEFAULT_RADIUS_M=1500
FACILITY_MAX_RADIUS_M=20000
EMERGENCY_HELPLINE=112
WARI_CONTROL_ROOM=1800-233-1000
